# Copy to .env and fill in your own values. Never commit .env.

# --- Meta WhatsApp Cloud API (Meta Developers > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=your-temporary-or-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id
VERIFY_TOKEN=pick-any-random-string-for-webhook-verification
# Optional: App secret (Meta Developers > App Settings > Basic) enables
# X-Hub-Signature-256 verification of incoming webhooks.
APP_SECRET=

# --- LLM fallback (OpenAI-compatible) ---
# OpenAI: key from https://platform.openai.com/api-keys (defaults below work as-is).
# Gemini: key from https://aistudio.google.com/apikey and set
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Business profile: ecommerce | clinic (matches profiles/*.json) ---
ACTIVE_PROFILE=ecommerce
